FROM debian:trixie@sha256:d07d1b51c39f51188e60be9b64e6bf769fa94e187f092bc32b91305cfa34ba5a

SHELL ["/bin/bash", "-o", "pipefail", "-o", "nounset", "-c"]

ARG USER_UID=1000
ARG USER_GID=1000

RUN groupadd -g ${USER_GID} vscode \
		&& useradd -l -u ${USER_UID} -g ${USER_GID} -d /home/vscode -s /bin/bash -m vscode

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
		ca-certificates \
		curl \
		file \
		git \
		shfmt \
		shellcheck \
		&& rm -rf /var/lib/apt/lists/*

# NOTE: Put everything specific to this repository within the `---` block.
# ---

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
		nodejs \
		npm \
		python3 \
		weasyprint \
		&& rm -rf /var/lib/apt/lists/*

RUN curl --fail --silent --show-error --location "https://github.com/gohugoio/hugo/releases/download/v0.164.0/hugo_extended_0.164.0_Linux-64bit.tar.gz" \
		-o /tmp/hugo.tar.gz \
		&& echo "fea17b8c076f950bb2e9f9486667bdaa29422883888d509d63931c73e8a9b3a4	/tmp/hugo.tar.gz" | sha256sum --check --strict \
		&& tar -xzf /tmp/hugo.tar.gz -C /tmp \
		&& mv /tmp/hugo /usr/local/bin/hugo \
		&& rm /tmp/hugo.tar.gz

COPY --chown=vscode:vscode package.json package-lock.json /tmp/deps/

# hadolint ignore=DL3066
USER vscode

# hadolint ignore=DL3003
RUN cd /tmp/deps \
		&& npm ci --no-audit --no-fund --loglevel=error \
		&& rm -rf /tmp/deps

# ---

# NOTE: The container's default user must remain root for Dev Container
# orchestrator setup and lifecycle hooks. The remoteUser in
# devcontainer.json drops to vscode for interactive development.
# DL3066 wants a numeric user id because a name may not resolve on the host,
# but `root` is uid 0 in every Linux image, so the concern does not apply;
# naming it reads better than `0` and the exclusion changes no behavior.
# hadolint ignore=DL3002,DL3066
USER root

RUN curl --fail --silent --show-error --location "https://github.com/hadolint/hadolint/releases/download/v2.15.1/hadolint-linux-x86_64" \
		-o /usr/local/bin/hadolint \
		&& echo "c7187db94eeeeca956519a6af171adc31453941a1e777961f6e680f697c8c507	/usr/local/bin/hadolint" | sha256sum --check --strict \
		&& chmod +x /usr/local/bin/hadolint

RUN curl --fail --silent --show-error --location "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz" \
		-o /tmp/gitleaks.tar.gz \
		&& echo "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb	/tmp/gitleaks.tar.gz" | sha256sum --check --strict \
		&& tar -xzf /tmp/gitleaks.tar.gz -C /tmp gitleaks \
		&& mv /tmp/gitleaks /usr/local/bin/gitleaks \
		&& rm /tmp/gitleaks.tar.gz

WORKDIR /workspace

CMD ["bash"]
